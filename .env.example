# Copy to .env to change the defaults. Every value is optional. Full reference: docs/install.md.

# Password of the Postgres user. Change it before you expose the stack to a network.
POSTGRES_PASSWORD=openjam
# Host port for the web app.
OPENJAM_PORT=8080
# Leave empty for no scan limit. A number caps scans per UTC day, per workspace.
OPENJAM_SCAN_CAP_PER_DAY=
# Set true when the site is served over HTTPS.
OPENJAM_COOKIE_SECURE=false
# Set false to stop new sign-ups after you create your account.
OPENJAM_ALLOW_SIGNUP=true
# Days a dashboard sign-in stays valid.
OPENJAM_SESSION_DAYS=30
# Log filter: error, warn, info, debug, or a per-crate list such as openjam_api=debug,info.
RUST_LOG=info
# API log format: json (one object per line) or text.
OPENJAM_LOG_FORMAT=json

# GitHub publishing. Create a GitHub App with Contents and Pull requests set to read and write,
# install it on your site repository, then set its id and private key (newlines written as \n).
# Both empty: publishing to GitHub is off. See docs/install.md.
OPENJAM_GITHUB_APP_ID=
OPENJAM_GITHUB_APP_PRIVATE_KEY=
# Only these repositories may be connected, as owner/name, separated by commas. Empty: every
# repository the App is installed on. Set it when more than one person signs up.
OPENJAM_GITHUB_REPOS=
# GitHub Enterprise Server only, for example https://github.example.com/api/v3
OPENJAM_GITHUB_API_URL=

# Set by compose.yml, not by this file (set them only when you run the binaries by hand):
# DATABASE_URL=postgres://openjam:openjam@localhost:5432/openjam   # required
# OPENJAM_BIND=0.0.0.0:8080                                        # API listen address
