FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release -p openjam-api -p openjam-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/openjam-api /usr/local/bin/openjam-api
COPY --from=build /src/target/release/openjam-worker /usr/local/bin/openjam-worker
EXPOSE 8080
CMD ["openjam-api"]
